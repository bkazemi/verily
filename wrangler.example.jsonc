// Copy to wrangler.jsonc and fill in your own deployment. wrangler.jsonc is
// gitignored: it names a specific Cloudflare account and a specific site owner,
// neither of which belongs in the library.
//
// Secrets are never set here. Use `wrangler secret put NAME` for:
//   GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, OWNER_KEY
// and, to offer Discord or YouTube sign-in, DISCORD_CLIENT_ID and DISCORD_CLIENT_SECRET
// or GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET. Each app needs
// <PUBLIC_ORIGIN>/api/verity/callback as a redirect.
// Each site listed in SITES below also needs its key as SITE_<ID>_KEY.
//
// Those two GitHub secrets are only needed by githubProvider(), the sign-in
// method, which is what cloudflare/worker.ts is wired to. The holder-paced
// methods need no registration and no secret at all: githubGistProvider()
// reads a public gist, and pgpProvider() checks a signature from an OpenPGP
// key. Swapping the provider in worker.ts is the whole change; a connection
// already established under one method keeps whichever method proved it.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "verity",
  "account_id": "YOUR_CLOUDFLARE_ACCOUNT_ID",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  // publicFetch() loads undici only on Node, so it has no place in the Worker.
  "alias": { "undici": "./cloudflare/undici.ts" },

  // Serve the backend from a host a reader can tie to the site making the
  // claim. Keep workers_dev true until the custom domain answers, then set it
  // false: the Worker rejects every origin except PUBLIC_ORIGIN, so only one
  // of the two can serve at a time.
  "workers_dev": true,
  // "routes": [{ "pattern": "verity.example.org", "custom_domain": true }],
  "preview_urls": false,
  "observability": { "enabled": false },

  // Keep the object name, binding and class identity stable across deploys:
  // changing them abandons the stored connections.
  "durable_objects": {
    "bindings": [{ "name": "VERITY", "class_name": "VerityStore" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VerityStore"] }],

  "vars": {
    // Drives baseUrl, every evidenceUrl and the verifier name. HTTPS, no
    // trailing slash, and it must match the origin actually serving requests.
    "PUBLIC_ORIGIN": "https://verity.example.org",
    // The site whose local subject is being linked. This is a claim the
    // evidence attributes to the site, not something the backend demonstrates.
    "SITE_NAME": "example.org",
    // What is linked: "account", "page" or "site". Omit for an account.
    "OWNER_KIND": "site",
    "OWNER_LABEL": "your-handle",
    "OWNER_REFERENCE": "example.org author",
    "OWNER_PROFILE_URL": "https://example.org/about/",
    "REPORT_URL": "mailto:you@example.org",
    // Sites that send their users here instead of hosting Verity; see docs/cloudflare.md.
    // "SITES": [
    //   {
    //     "id": "partner",
    //     "name": "partner.example",
    //     "origin": "https://partner.example",
    //     "authorizeUrl": "https://partner.example/verity/authorize",
    //     "returnUrl": "https://partner.example/verity/return",
    //   },
    // ],
  },
}
